# Android Auto uses Android Open Accessory Protocol (AOAP). Before AOAP, a
# phone has its manufacturer-specific USB vendor/product IDs; the standard
# Google IDs (18d1:2d00 or 18d1:2d01) appear only after AA2ACP has opened it
# and requested accessory mode. A fixed phone-ID allowlist therefore cannot
# support arbitrary Android phones.
#
# The bridge service account must belong to aa2acp. This deliberately grants
# that dedicated, trusted group access to USB devices so AASDK can probe for
# AOAP support. The grant is intentionally NOT tagged with "uaccess": that
# would additionally expose devices to logged-in desktop users, widening the
# surface beyond the service account.
#
# Post-AOAP Google IDs get an explicit rule so the common case (phone already
# in accessory mode) does not depend on the blanket grant.
SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", ATTRS{idProduct}=="2d00", MODE="0660", GROUP="aa2acp"
SUBSYSTEM=="usb", ATTRS{idVendor}=="18d1", ATTRS{idProduct}=="2d01", MODE="0660", GROUP="aa2acp"

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", MODE="0660", GROUP="aa2acp"
