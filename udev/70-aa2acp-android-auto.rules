# Android Auto uses Android Open Accessory Protocol (AOAP). Before AOAP, a
# phone has its manufacturer-specific USB vendor/product IDs; the standard
# Google IDs (18d1:2d00 or 18d1:2d01) appear only after AA2ACP has opened it
# and requested accessory mode. A fixed phone-ID allowlist therefore cannot
# support arbitrary Android phones.
#
# The bridge service account must belong to aa2acp. This deliberately grants
# that dedicated, trusted group access to USB devices so AASDK can probe for
# AOAP support.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", MODE="0660", GROUP="aa2acp", TAG+="uaccess"
