#!/bin/bash
# Maintainer script for aa2acp deb packages. Written to be safe both on a
# running system and during offline image assembly (chroot / rpi-image-gen):
# every runtime-touching action is guarded, everything is idempotent so it
# can run on every upgrade.

set -e

case "$1" in
configure)
    # System group for USB device access (udev rule grants this group).
    getent group aa2acp >/dev/null || groupadd --system aa2acp

    # Dedicated service account (its primary group is aa2acp, so it gets
    # USB access). State lives in /var/lib/aa2acp via XDG_STATE_HOME.
    getent passwd aa2acp >/dev/null || adduser --system \
        --ingroup aa2acp --home /var/lib/aa2acp \
        --shell /usr/sbin/nologin --no-create-home aa2acp
    mkdir -p /var/lib/aa2acp
    chown aa2acp:aa2acp /var/lib/aa2acp

    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null; then
        # Running system: enable units, reload managers.
        systemctl enable aa2acp.service >/dev/null || true
        systemctl daemon-reload >/dev/null || true
        if [ -n "$2" ]; then
            # Upgrade (old version in $2): restart into the new binary.
            systemctl try-restart aa2acp.service >/dev/null || true
        fi
        [ -d /run/udev ] && udevadm control --reload >/dev/null || true
    elif command -v deb-systemd-helper >/dev/null; then
        # Offline install (image build): stage enablement without a PID 1.
        deb-systemd-helper enable aa2acp.service >/dev/null || true
        deb-systemd-helper update-state aa2acp.service >/dev/null || true
    fi
    ;;
esac

exit 0
