[Unit]
Description=AA2ACP bridge
Wants=NetworkManager.service bluetooth.service
After=NetworkManager.service bluetooth.service

[Service]
Type=simple
# TODO(appliance-image): run as a dedicated system account once the image
# defines one; the state directory follows the user's XDG_STATE_HOME.
User=pi
Group=pi
SupplementaryGroups=aa2acp
ExecStart=/usr/bin/aa2acp --no-file-log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
